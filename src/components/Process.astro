---
const steps = [
  {
    n: "01",
    title: "Diagnose first",
    copy: "Before I build, I find out where the work actually breaks and what it costs. The owner signs off on the plan, so nothing gets built on a guess.",
  },
  {
    n: "02",
    title: "Build, test, then go live",
    copy: "I build on the tools the team already uses and test against real data. Nothing goes live until the owner approves it. When priorities change, I confirm the new scope in writing.",
  },
  {
    n: "03",
    title: "Document and stay in touch",
    copy: "Every system gets a written context file, so nothing depends on memory. I report directly to founders on whatever channel they prefer, usually WhatsApp, with fixed weekly check-ins.",
  },
];
---

<section class="section process dark" id="how">
  <div class="wrap">
    <div class="process__head">
      <h2 data-reveal>How I work</h2>
      <p class="lede" data-reveal style="--delay:120ms">
        Remote, async-friendly, and organized around the owner. The same three habits on every
        project.
      </p>
    </div>

    <ol class="process__list">
      {
        steps.map((s, i) => (
          <li class="step" data-reveal style={`--delay:${i * 110}ms`}>
            <span class="step__n">{s.n}</span>
            <h3>{s.title}</h3>
            <p>{s.copy}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .process {
    background: var(--navy);
  }

  .process__head {
    display: grid;
    gap: 20px;
    max-width: 60ch;
    margin-bottom: clamp(48px, 6vw, 80px);
  }

  .process__list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--line-dark);
    border: 1px solid var(--line-dark);
  }

  .step {
    background: var(--navy);
    padding: clamp(28px, 3.2vw, 44px);
    display: grid;
    gap: 14px;
    align-content: start;
    position: relative;
    transition: background 0.5s var(--ease);
  }

  .step::after {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    height: 2px;
    width: 100%;
    background: var(--cyan);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.6s var(--ease);
  }

  .step:hover {
    background: var(--navy-2);
  }

  .step:hover::after {
    transform: scaleX(1);
  }

  .step__n {
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    color: var(--cyan);
  }

  .step p {
    color: var(--mute-dark);
    font-size: 0.98rem;
    line-height: 1.66;
  }

  @media (max-width: 860px) {
    .process__list {
      grid-template-columns: 1fr;
    }
  }
</style>
