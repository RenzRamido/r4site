---
import { cv } from "../data/site.js";

const timeline = [
  { when: "Now", what: "AI Automation and Technical Operations Consultant, working directly with US business owners" },
  { when: "2021 to 2024", what: "Owner and operator of my own restaurant: money, staffing and daily operations" },
  { when: "Earlier", what: "Tenured technical support representative" },
  { when: "Education", what: "Bachelor of Science in Information Technology" },
];
---

<section class="section about" id="about">
  <div class="wrap about__grid">
    <div class="about__media" data-reveal>
      <div class="portrait">
        <img
          src="/portrait.webp"
          alt="Renz Rodney Ramido"
          width="1103"
          height="1426"
          loading="lazy"
          decoding="async"
        />
      </div>
      <p class="portrait__cap">Renz Rodney Ramido, Philippines</p>
    </div>

    <div class="about__body">
      <h2 data-reveal>About</h2>

      <p class="lede" data-reveal style="--delay:100ms">
        I am Renz Rodney Ramido, an AI automation and technical operations specialist based in the
        Philippines. I build the systems that take manual work off a business owner's plate, and I
        stay accountable for them after they go live.
      </p>

      <p class="lede" data-reveal style="--delay:160ms">
        My background is operations before it was automation. I worked in technical support,
        then ran my own restaurant for three years, handling the money, the staffing and the days
        that did not go to plan. That is why I start with where the work actually breaks, not with a
        piece of software.
      </p>

      <p class="lede" data-reveal style="--delay:220ms">
        I build with AI-assisted development, which lets me ship quickly without cutting corners.
        This website is an example of it. Every decision on this page is one I can explain.
      </p>

      <ol class="timeline" data-reveal style="--delay:280ms">
        {
          timeline.map((t) => (
            <li>
              <span class="timeline__when">{t.when}</span>
              <span class="timeline__what">{t.what}</span>
            </li>
          ))
        }
      </ol>

      <div class="about__cta" data-reveal style="--delay:320ms">
        <a class="btn" href={cv} download>Download CV</a>
        <a class="btn btn--ghost" href="#contact">Get in touch</a>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    background: var(--haze);
    border-top: 1px solid var(--line);
  }

  .about__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    gap: clamp(32px, 5vw, 80px);
  }

  .about__media {
    position: sticky;
    top: 130px;
  }

  .portrait {
    background: var(--navy);
    border-radius: 6px;
    overflow: hidden;
  }

  .portrait img {
    width: 100%;
    height: auto;
    display: block;
  }

  .portrait__cap {
    margin-top: 14px;
    font-family: var(--mono);
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--mute);
  }

  .about__body {
    display: grid;
    gap: 20px;
    justify-items: start;
  }

  .timeline {
    display: grid;
    width: 100%;
    margin-top: 6px;
    border-top: 1px solid var(--line-strong);
  }

  .timeline li {
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line-strong);
  }

  .timeline__when {
    font-family: var(--mono);
    font-size: 0.76rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--blue);
    padding-top: 2px;
  }

  .timeline__what {
    font-size: 0.96rem;
    color: var(--ink-2);
    line-height: 1.55;
  }

  .about__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 8px;
  }

  @media (max-width: 520px) {
    .timeline li {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }

  @media (max-width: 860px) {
    .about__grid {
      grid-template-columns: 1fr;
    }

    .about__media {
      position: static;
      max-width: 420px;
    }
  }
</style>
